# =============================================================================
# DiffWeave Configuration (.env)
# Semantic Version Control & PR Review Deck for DocWeave Knowledge
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Connection Mode (Remote MCP Server vs. Local DocWeave)
# -----------------------------------------------------------------------------
# For deployed / cloud instances (e.g. Hugging Face Spaces or custom domain):
# DOCWEAVE_MCP_URL=https://your-docweave.hf.space
# DOCWEAVE_API_KEY=your-docweave-personal-access-token

# For local development with DocWeave on the same machine:
DOCWEAVE_BACKEND_DIR=../DocWeave/backend
DOCWEAVE_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. Database & Auth (Shared with DocWeave for Unified Identity)
# -----------------------------------------------------------------------------
# Shared Neon PostgreSQL database URL
DATABASE_URL=postgresql://neondb_owner:your_database_password_here@ep-your-project-pooler.c-3.region.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key (Must match DocWeave SECRET_KEY to verify tokens)
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# 3. Workspace Defaults
# -----------------------------------------------------------------------------
# Default target workspace ID (e.g., Cardiology workspace)
DIFFWEAVE_WORKSPACE_ID=3e24fa72-b6c2-4427-9e44-b26a997fd205

# -----------------------------------------------------------------------------
# 4. DiffWeave Studio Server Bridge
# -----------------------------------------------------------------------------
PORT=7860
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# 5. Email & Notification Delivery (Optional - for DocWeave OTP / email verification)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# SMTP_FROM=DocWeave <noreply@doc-weave.xyz>
# FRONTEND_URL=http://localhost:7860
